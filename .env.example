# LinkDogger configuration
# Copy this file to .env and adjust values as needed.
# Never commit .env — API keys and secrets must stay out of the repository.

LINKDOGGER_LOG_LEVEL=INFO
LINKDOGGER_WEB_HOST=127.0.0.1
LINKDOGGER_WEB_PORT=8000

# Discovery backend: "mock" (sample data, default) or "github" (official API).
# Used by the web interface; the CLI picks a provider with --provider.
# LINKDOGGER_DISCOVERY_BACKEND=mock

# Optional GitHub token to raise API rate limits. NEVER commit this value.
# LINKDOGGER_GITHUB_TOKEN=

# LinkedIn provider (optional): either a session cookie file or your own
# LinkedIn account credentials. The library uses the cookies to call
# LinkedIn's Voyager API and caches sessions for reuse. NEVER commit these.
# LINKDOGGER_LINKEDIN_EMAIL=
# LINKDOGGER_LINKEDIN_PASSWORD=

# Where open-linkedin-api caches session cookies (default: ~/.linkedin_api/cookies/).
# LINKDOGGER_LINKEDIN_COOKIES_DIR=

# Alternative to credentials: path to a session cookie file (li_at +
# JSESSIONID) created with `linkdogger linkedin-login`. Takes priority
# over LINKDOGGER_LINKEDIN_EMAIL/PASSWORD when both are set.
# LINKDOGGER_LINKEDIN_COOKIE_FILE=linkedin-cookies.json

# HTTP request timeout for discovery/enrichment calls (seconds).
# LINKDOGGER_REQUEST_TIMEOUT_SECONDS=10.0

# Timeout for the GitHub .patch email lookup (seconds).
# Set to 0 to skip the .patch lookup and rely on commit-author + search APIs.
# LINKDOGGER_GITHUB_EMAIL_PATCH_TIMEOUT_SECONDS=10.0

# Default maximum number of results per search.
# LINKDOGGER_MAX_RESULTS=100

# --- Local IPC server (linkdogger ipc-serve) ---
# JSON-over-HTTP API on localhost for other processes and scripts.
# Set a token to require Authorization: Bearer <token> on every call.
# LINKDOGGER_IPC_HOST=127.0.0.1
# LINKDOGGER_IPC_PORT=8123
# LINKDOGGER_IPC_TOKEN=

# --- SMTP outbox (linkdogger send) ---
# Sends personalized outreach emails from the exported contacts file.
# LINKDOGGER_SMTP_HOST=smtp.gmail.com
# LINKDOGGER_SMTP_PORT=587
# LINKDOGGER_SMTP_USERNAME=you@gmail.com
# LINKDOGGER_SMTP_PASSWORD=app-password
# LINKDOGGER_SMTP_FROM=you@gmail.com
# LINKDOGGER_SMTP_FROM_NAME=Your Name
# LINKDOGGER_SMTP_STARTTLS=true

# --- IMAP inbox (linkdogger watch) ---
# Watches for replies from the contacts you emailed and reports them.
# LINKDOGGER_IMAP_HOST=imap.gmail.com
# LINKDOGGER_IMAP_PORT=993
# LINKDOGGER_IMAP_USERNAME=you@gmail.com
# LINKDOGGER_IMAP_PASSWORD=app-password
# LINKDOGGER_IMAP_FOLDER=INBOX
# LINKDOGGER_IMAP_STARTTLS=false
